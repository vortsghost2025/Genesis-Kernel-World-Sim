{
  "customCommands": [
    {
      "name": "test-all",
      "command": "cd world-sim && python -m pytest tests/ -q",
      "description": "Run all First Pair tests"
    },
    {
      "name": "test-runtime",
      "command": "cd world-sim && python -m pytest tests/test_first_pair_runtime.py -q",
      "description": "Runtime tests"
    },
    {
      "name": "compile",
      "command": "cd world-sim && python -m py_compile backend/world/first_pair_*.py scripts/run_first_pair_demo.py",
      "description": "Py-compile all source files"
    },
    {
      "name": "diff-check",
      "command": "git diff --check",
      "description": "Whitespace/conflict check"
    }
  ]
}
