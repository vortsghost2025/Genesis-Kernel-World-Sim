# Genesis Viewer configuration
# Copy to .env for docker-compose, or export for systemd.

# demo (packaged snapshot, no live source) | live (reads canonical stores)
GENESIS_MODE=demo

# port to bind (0.0.0.0)
GENESIS_PORT=8000

# live-mode: how often to refresh the snapshot from the stores
GENESIS_REFRESH_SECONDS=60

# live-mode: canonical store paths (on the source machine)
# GENESIS_STORE_EAST=/path/to/world-sim/.runtime/first-pair
# GENESIS_STORE_WEST=/path/to/world-sim/.runtime/first-pair-west

# rate limit for POST /refresh (requests per minute per IP)
GENESIS_REFRESH_RPM=2
