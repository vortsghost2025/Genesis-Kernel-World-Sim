{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "genesis-code-index": {
      "type": "local",
      "command": ["python", "tooling/code-index-mcp/run_server.py"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "command": {
    "test-all": {
      "template": "Run all First Pair tests from the repo root by executing: python world-sim/scripts/run_first_pair_checks.py full",
      "description": "Run all First Pair tests"
    },
    "test-runtime": {
      "template": "Run First Pair runtime tests by executing: python world-sim/scripts/run_first_pair_checks.py runtime",
      "description": "Run First Pair runtime tests"
    },
    "compile": {
      "template": "Compile-check First Pair source files by executing: python world-sim/scripts/run_first_pair_checks.py compile",
      "description": "Compile-check all First Pair source files"
    },
    "diff-check": {
      "template": "Check git diff for whitespace/conflict issues by executing: git diff --check",
      "description": "Check git diff for whitespace/conflict issues"
    },
    "code-definition": {
      "template": "Find the definition of a symbol using the genesis-code-index MCP find_definition tool",
      "description": "Find symbol definition via code index MCP"
    },
    "code-references": {
      "template": "Find references to a symbol using the genesis-code-index MCP find_references tool",
      "description": "Find symbol references via code index MCP"
    },
    "code-callers": {
      "template": "Find callers of a function using the genesis-code-index MCP find_callers tool",
      "description": "Find function callers via code index MCP"
    },
    "code-search": {
      "template": "Search the codebase using the genesis-code-index MCP lexical_search or semantic_search tool",
      "description": "Search codebase via code index MCP"
    },
    "code-reindex": {
      "template": "Rebuild the code index by executing: python world-sim/scripts/run_first_pair_checks.py code-index",
      "description": "Rebuild the code index database"
    },
    "code-status": {
      "template": "Show code index status by executing: python world-sim/scripts/run_first_pair_checks.py code-index-status",
      "description": "Show code index status"
    }
  }
}
